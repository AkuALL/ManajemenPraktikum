# Salin file ini menjadi .env, lalu isi dengan konfigurasi Web App dari Firebase Console.
# Nilai Firebase berikut adalah identifier aplikasi dan sengaja memakai prefix EXPO_PUBLIC_.
# Jangan pernah menaruh API key layanan AI atau credential server di file ini.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL HTTPS publik untuk proxy/Cloud Function klasifikasi alasan izin.
# Hanya URL yang boleh disimpan di client; jangan pernah isi API key AI di sini.
EXPO_PUBLIC_AI_CLASSIFIER_URL=https://asia-southeast2-manajemenpraktikum.cloudfunctions.net/classifyLeaveReason
