rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUserIdentifier() {
      return get(userProfilePath(request.auth.uid)).data.identifier;
    }

    function hasRole(role) {
      return signedIn()
        && exists(userProfilePath(request.auth.uid))
        && get(userProfilePath(request.auth.uid)).data.role == role;
    }

    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function memberPath(classId, uid) {
      return /databases/$(database)/documents/classes/$(classId)/members/$(uid);
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function sessionQrPath(sessionId) {
      return /databases/$(database)/documents/sessionQr/$(sessionId);
    }

    function labPath(labId) {
      return /databases/$(database)/documents/labs/$(labId);
    }

    function isClassAssistant(classId) {
      return signedIn()
        && exists(classPath(classId))
        && get(classPath(classId)).data.assistantIds.hasAny([request.auth.uid]);
    }

    function isStudentMember(classId) {
      return hasRole('student')
        && (
          (exists(memberPath(classId, currentUserIdentifier()))
            && get(memberPath(classId, currentUserIdentifier())).data.role == 'student')
          || (exists(memberPath(classId, request.auth.uid))
            && get(memberPath(classId, request.auth.uid)).data.role == 'student')
        );
    }

    function validText(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen;
    }

    function validProfileCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'role',
          'identifier',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'role',
          'identifier',
          'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && ['student', 'assistant'].hasAny([request.resource.data.role])
        && validText(request.resource.data.displayName, 2, 100)
        && validText(request.resource.data.identifier, 3, 40)
        && request.resource.data.createdAt == request.time;
    }

    function validProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'identifier', 'updatedAt', 'pushTokens', 'lastTokenUpdatedAt'])
        && validText(request.resource.data.displayName, 2, 100)
        && validText(request.resource.data.identifier, 3, 40)
        && (!request.resource.data.keys().hasAll(['pushTokens'])
          || (request.resource.data.pushTokens is list
            && request.resource.data.pushTokens.size() <= 5))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastTokenUpdatedAt'])
          || request.resource.data.lastTokenUpdatedAt == request.time)
        && request.resource.data.updatedAt == request.time;
    }

    function validClassCreate() {
      return request.resource.data.keys().hasOnly([
          'practicumName',
          'className',
          'lab',
          'assistantIds',
          'memberUids',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'practicumName',
          'className',
          'assistantIds',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.assistantIds is list
        && request.resource.data.assistantIds.hasAny([request.auth.uid])
        && (!request.resource.data.keys().hasAll(['memberUids'])
          || request.resource.data.memberUids is list)
        && validText(request.resource.data.practicumName, 2, 120)
        && validText(request.resource.data.className, 2, 80)
        && (!request.resource.data.keys().hasAll(['lab'])
          || validText(request.resource.data.lab, 2, 120))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validClassUpdate() {
      return !resource.data.get('archived', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'practicumName',
          'className',
          'lab',
          'assistantIds',
          'memberUids',
          'archived',
          'archivedBy',
          'archivedAt',
          'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.assistantIds == resource.data.assistantIds
        && validText(request.resource.data.practicumName, 2, 120)
        && validText(request.resource.data.className, 2, 80)
        && (!request.resource.data.keys().hasAll(['lab'])
          || validText(request.resource.data.lab, 2, 120))
        && (!request.resource.data.keys().hasAll(['memberUids'])
          || request.resource.data.memberUids is list)
        && (
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'archived',
              'archivedBy',
              'archivedAt'
            ])
            && !request.resource.data.keys().hasAny(['archivedBy', 'archivedAt'])
            && (!('archived' in request.resource.data)
              || request.resource.data.archived == false)
          )
          || (
            request.resource.data.keys().hasAll(['archived', 'archivedBy', 'archivedAt'])
            && request.resource.data.archived == true
            && request.resource.data.archivedBy == request.auth.uid
            && request.resource.data.archivedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'archived',
              'archivedBy',
              'archivedAt',
              'updatedAt'
            ])
          )
        )
        && request.resource.data.updatedAt == request.time;
    }

    function validMemberCreate(memberId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'role',
          'displayName',
          'identifier',
          'joinedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId',
          'role',
          'displayName',
          'identifier',
          'joinedAt'
        ])
        && request.resource.data.userId == memberId
        && request.resource.data.identifier == memberId
        && request.resource.data.role == 'student'
        && validText(request.resource.data.displayName, 2, 100)
        && validText(request.resource.data.identifier, 3, 40)
        && request.resource.data.joinedAt == request.time;
    }

    function validMemberUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'identifier'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.identifier == resource.data.identifier
        && request.resource.data.role == 'student'
        && request.resource.data.joinedAt == resource.data.joinedAt
        && validText(request.resource.data.displayName, 2, 100)
        && validText(request.resource.data.identifier, 3, 40);
    }

    function validSessionCreate() {
      return request.resource.data.keys().hasOnly([
          'classId',
          'title',
          'location',
          'labId',
          'locationName',
          'latitude',
          'longitude',
          'radiusMeters',
          'startsAt',
          'endsAt',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'classId',
          'title',
          'startsAt',
          'endsAt',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.status == 'scheduled'
        && request.resource.data.createdBy == request.auth.uid
        && validText(request.resource.data.title, 2, 140)
        && validText(request.resource.data.location, 2, 120)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.startsAt < request.resource.data.endsAt
        && request.resource.data.startsAt >= request.time - duration.value(5, 'm')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validMasterLabSnapshot();
    }

    function validSessionLocationSnapshot() {
      let locationKeys = ['labId', 'locationName', 'latitude', 'longitude', 'radiusMeters'];
      return !request.resource.data.keys().hasAny(locationKeys)
        || (request.resource.data.keys().hasAll(locationKeys)
          && validText(request.resource.data.labId, 1, 160)
          && validText(request.resource.data.locationName, 2, 120)
          && request.resource.data.location == request.resource.data.locationName
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.radiusMeters is number
          && request.resource.data.radiusMeters >= 1
          && request.resource.data.radiusMeters <= 500);
    }

    function matchesMasterLabData(lab) {
      return lab.isActive == true
        && request.resource.data.locationName == lab.name
        && request.resource.data.location == lab.name
        && request.resource.data.latitude == lab.latitude
        && request.resource.data.longitude == lab.longitude
        && request.resource.data.radiusMeters == lab.radiusMeters;
    }

    function validMasterLabSnapshot() {
      let locationKeys = ['labId', 'locationName', 'latitude', 'longitude', 'radiusMeters'];
      return request.resource.data.keys().hasAll(locationKeys)
        && validText(request.resource.data.labId, 1, 160)
        && request.resource.data.labId.matches('^[^/]+$')
        && request.resource.data.labId != '.'
        && request.resource.data.labId != '..'
        && validText(request.resource.data.locationName, 2, 120)
        && request.resource.data.location == request.resource.data.locationName
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radiusMeters is number
        && request.resource.data.radiusMeters >= 10
        && request.resource.data.radiusMeters <= 500
        && exists(labPath(request.resource.data.labId))
        && matchesMasterLabData(get(labPath(request.resource.data.labId)).data);
    }

    function validSessionStatusTransition() {
      return request.resource.data.status == resource.data.status
        || (
          resource.data.status == 'scheduled'
          && request.resource.data.status == 'open'
          && request.time >= resource.data.startsAt
          && request.time <= resource.data.endsAt
          && request.resource.data.openedBy == request.auth.uid
          && request.resource.data.openedAt == request.time
        )
        || (
          resource.data.status == 'open'
          && request.resource.data.status == 'closed'
          && request.resource.data.closedBy == request.auth.uid
          && request.resource.data.closedAt == request.time
        )
        || (
          resource.data.status == 'scheduled'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt == request.time
        );
    }

    function validSessionUpdate() {
      return request.resource.data.keys().hasOnly([
          'classId',
          'title',
          'location',
          'labId',
          'locationName',
          'latitude',
          'longitude',
          'radiusMeters',
          'startsAt',
          'endsAt',
          'status',
          'openedBy',
          'openedAt',
          'closedBy',
          'closedAt',
          'cancelledBy',
          'cancelledAt',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && resource.data.status != 'cancelled'
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && validText(request.resource.data.title, 2, 140)
        && validText(request.resource.data.location, 2, 120)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.startsAt < request.resource.data.endsAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'location',
              'labId',
              'locationName',
              'latitude',
              'longitude',
              'radiusMeters'
            ])
            && validSessionLocationSnapshot()
          )
          || validMasterLabSnapshot()
        )
        && (
          resource.data.status == 'scheduled'
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'openedBy',
            'openedAt',
            'closedBy',
            'closedAt',
            'updatedAt'
          ])
        )
        && (
          (
            request.resource.data.status != 'cancelled'
            && !request.resource.data.keys().hasAny(['cancelledBy', 'cancelledAt'])
          )
          || (
            request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'cancelledBy',
              'cancelledAt',
              'updatedAt'
            ])
          )
        )
        && validSessionStatusTransition();
    }

    function isOpenStudentSession(sessionId, classId) {
      return isStudentMember(classId)
        && exists(sessionPath(sessionId))
        && get(sessionPath(sessionId)).data.classId == classId
        && get(sessionPath(sessionId)).data.status == 'open';
    }

    function withinSessionCoords(s) {
      let dLat = (request.resource.data.latitude - s.latitude) * 111195;
      let dLng = (request.resource.data.longitude - s.longitude) * 111195 * 0.9924;
      let allowedRadius = s.radiusMeters + 1;
      return dLat * dLat + dLng * dLng <= allowedRadius * allowedRadius
        && request.resource.data.distanceMeters <= allowedRadius;
    }

    function hasValidSessionGeo(s) {
      return s.keys().hasAll(['latitude', 'longitude', 'radiusMeters'])
        && s.latitude is number
        && s.longitude is number
        && s.radiusMeters is number
        && s.radiusMeters > 0
        && withinSessionCoords(s);
    }

    function withinSessionRadius(sessionId) {
      return exists(sessionPath(sessionId))
        && hasValidSessionGeo(get(sessionPath(sessionId)).data);
    }

    function isLeaveEligibleSession(sessionId, classId) {
      return isStudentMember(classId)
        && exists(sessionPath(sessionId))
        && get(sessionPath(sessionId)).data.classId == classId
        && ['scheduled', 'open'].hasAny([get(sessionPath(sessionId)).data.status]);
    }

    function validAttendanceCreate(attendanceId) {
      return request.resource.data.keys().hasOnly([
          'sessionId',
          'classId',
          'studentId',
          'studentName',
          'studentIdentifier',
          'attendedAt',
          'latitude',
          'longitude',
          'accuracy',
          'distanceMeters',
          'isWithinRadius',
          'attendanceMethod',
          'qrToken'
        ])
        && request.resource.data.keys().hasAll([
          'sessionId',
          'classId',
          'studentId',
          'studentName',
          'studentIdentifier',
          'attendedAt',
          'latitude',
          'longitude',
          'accuracy',
          'distanceMeters',
          'isWithinRadius',
          'attendanceMethod',
          'qrToken'
        ])
        && request.resource.data.studentId == request.auth.uid
        && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.studentName == get(userProfilePath(request.auth.uid)).data.displayName
        && request.resource.data.studentIdentifier == get(userProfilePath(request.auth.uid)).data.identifier
        && request.resource.data.attendedAt == request.time
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.distanceMeters is number
        && request.resource.data.distanceMeters >= 0
        && request.resource.data.isWithinRadius is bool
        && request.resource.data.isWithinRadius == true
        && isOpenStudentSession(
          request.resource.data.sessionId,
          request.resource.data.classId
        )
        && withinSessionRadius(request.resource.data.sessionId)
        && request.resource.data.attendanceMethod == 'qr'
        && validText(request.resource.data.qrToken, 12, 160)
        && exists(sessionQrPath(request.resource.data.sessionId))
        && get(sessionQrPath(request.resource.data.sessionId)).data.classId == request.resource.data.classId
        && get(sessionQrPath(request.resource.data.sessionId)).data.token == request.resource.data.qrToken
        && get(sessionQrPath(request.resource.data.sessionId)).data.expiresAt > request.time;
    }

    function validAssistantAttendanceCreate(attendanceId) {
      return request.resource.data.keys().hasOnly([
          'sessionId', 'classId', 'studentId', 'studentName', 'studentIdentifier', 'attendedAt',
          'latitude', 'longitude', 'accuracy', 'distanceMeters', 'isWithinRadius',
          'attendanceMethod', 'recordedBy', 'assistanceReason'
        ])
        && request.resource.data.keys().hasAll([
          'sessionId', 'classId', 'studentId', 'studentName', 'studentIdentifier', 'attendedAt',
          'latitude', 'longitude', 'accuracy', 'distanceMeters', 'isWithinRadius',
          'attendanceMethod', 'recordedBy', 'assistanceReason'
        ])
        && attendanceId == request.resource.data.sessionId + '_' + request.resource.data.studentId
        && request.resource.data.attendanceMethod == 'assistant_override'
        && request.resource.data.recordedBy == request.auth.uid
        && validText(request.resource.data.assistanceReason, 5, 300)
        && request.resource.data.attendedAt == request.time
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.accuracy == 0
        && request.resource.data.distanceMeters == 0
        && request.resource.data.isWithinRadius == false
        && exists(userProfilePath(request.resource.data.studentId))
        && get(userProfilePath(request.resource.data.studentId)).data.role == 'student'
        && request.resource.data.studentName == get(userProfilePath(request.resource.data.studentId)).data.displayName
        && request.resource.data.studentIdentifier == get(userProfilePath(request.resource.data.studentId)).data.identifier
        && exists(memberPath(request.resource.data.classId, request.resource.data.studentIdentifier))
        && get(memberPath(request.resource.data.classId, request.resource.data.studentIdentifier)).data.userId == request.resource.data.studentIdentifier
        && isClassAssistant(request.resource.data.classId)
        && exists(sessionPath(request.resource.data.sessionId))
        && get(sessionPath(request.resource.data.sessionId)).data.classId == request.resource.data.classId
        && get(sessionPath(request.resource.data.sessionId)).data.status == 'open';
    }

    function validLeaveSentiment(analysis) {
      return analysis is map
        && analysis.keys().hasOnly(['model', 'label'])
        && analysis.keys().hasAll(['model', 'label'])
        && analysis.model == 'edom-v1'
        && [null, 'positif', 'netral', 'negatif'].hasAny([analysis.label]);
    }

    function validLeaveCreate(leaveId) {
      return request.resource.data.keys().hasOnly([
          'sessionId',
          'classId',
          'studentId',
          'reason',
          'status',
          'aiStatus',
          'sentimentAnalysis',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'sessionId',
          'classId',
          'studentId',
          'reason',
          'status',
          'aiStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && leaveId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.aiStatus == 'pending'
        && (!('sentimentAnalysis' in request.resource.data)
          || validLeaveSentiment(request.resource.data.sentimentAnalysis))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isLeaveEligibleSession(
          request.resource.data.sessionId,
          request.resource.data.classId
        );
    }

    function validLeaveDecision() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedBy',
          'reviewedAt',
          'reviewNote',
          'updatedAt'
        ])
        && resource.data.status == 'pending'
        && ['approved', 'rejected'].hasAny([request.resource.data.status])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validLeaveSentimentUpdate() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentimentAnalysis'])
        && validLeaveSentiment(request.resource.data.sentimentAnalysis)
        && (!('sentimentAnalysis' in resource.data)
          || request.resource.data.sentimentAnalysis == resource.data.sentimentAnalysis);
    }

    function validLeaveClassificationFailure() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aiStatus',
          'updatedAt'
        ])
        && resource.data.status == 'pending'
        && resource.data.aiStatus == 'pending'
        && request.resource.data.aiStatus == 'failed'
        && request.resource.data.updatedAt == request.time;
    }

    function validLeaveClassificationSuccess() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aiStatus',
          'aiCategory',
          'aiConfidence',
          'aiClassifiedAt',
          'updatedAt'
        ])
        && resource.data.status == 'pending'
        && ['pending', 'failed'].hasAny([resource.data.aiStatus])
        && request.resource.data.aiStatus == 'success'
        && ['sakit', 'keluarga', 'akademik', 'darurat', 'lainnya']
          .hasAny([request.resource.data.aiCategory])
        && request.resource.data.aiConfidence is number
        && request.resource.data.aiConfidence >= 0
        && request.resource.data.aiConfidence <= 1
        && request.resource.data.aiClassifiedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validNotificationCreate() {
      return request.resource.data.keys().hasOnly([
          'recipientUid',
          'senderUid',
          'title',
          'body',
          'type',
          'data',
          'status',
          'sentAt'
        ])
        && request.resource.data.keys().hasAll([
          'recipientUid',
          'senderUid',
          'title',
          'body',
          'type',
          'data',
          'status',
          'sentAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && validText(request.resource.data.recipientUid, 1, 160)
        && validText(request.resource.data.title, 1, 160)
        && validText(request.resource.data.body, 1, 600)
        && request.resource.data.data is map
        && ['sent', 'skipped', 'failed'].hasAny([request.resource.data.status])
        && request.resource.data.sentAt == request.time
        && (
          (hasRole('assistant')
            && ['SESSION_OPENED', 'SCHEDULE_CHANGED', 'LEAVE_APPROVED', 'LEAVE_REJECTED']
              .hasAny([request.resource.data.type]))
          || (hasRole('student') && request.resource.data.type == 'LEAVE_SUBMITTED')
        );
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId
          || (hasRole('assistant') && resource.data.role == 'student'));
      allow list: if hasRole('assistant') && resource.data.role == 'student';
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfileCreate(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validProfileUpdate();
      allow delete: if false;

      match /webPushTokens/{tokenId} {
        allow get, list, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && tokenId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && validText(request.resource.data.token, 20, 4096)
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /classes/{classId} {
      allow get: if signedIn()
        && (request.auth.uid in resource.data.assistantIds
          || ('memberUids' in resource.data
            && (currentUserIdentifier() in resource.data.memberUids
              || request.auth.uid in resource.data.memberUids))
          || exists(memberPath(classId, currentUserIdentifier()))
          || exists(memberPath(classId, request.auth.uid)));
      allow list: if signedIn()
        && (request.auth.uid in resource.data.assistantIds
          || currentUserIdentifier() in resource.data.memberUids
          || request.auth.uid in resource.data.memberUids);
      allow create: if hasRole('assistant') && validClassCreate();
      allow update: if isClassAssistant(classId) && validClassUpdate();
      allow delete: if false;

      match /members/{memberId} {
        allow get: if isClassAssistant(classId)
          || (signedIn() && (currentUserIdentifier() == memberId || request.auth.uid == memberId));
        allow list: if isClassAssistant(classId);
        allow create: if isClassAssistant(classId)
          && !get(classPath(classId)).data.get('archived', false)
          && validMemberCreate(memberId);
        allow update: if isClassAssistant(classId)
          && !get(classPath(classId)).data.get('archived', false)
          && validMemberUpdate();
        allow delete: if isClassAssistant(classId)
          && !get(classPath(classId)).data.get('archived', false);
      }
    }

    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && (resource.data.userId == currentUserIdentifier()
          || resource.data.identifier == currentUserIdentifier()
          || resource.data.userId == request.auth.uid);
    }

    match /sessions/{sessionId} {
      allow get, list: if isClassAssistant(resource.data.classId)
        || (signedIn()
          && (exists(memberPath(resource.data.classId, currentUserIdentifier()))
            || exists(memberPath(resource.data.classId, request.auth.uid))))
        || (signedIn() && (resource.data.status == 'open' || resource.data.status == 'scheduled'));
      allow create: if hasRole('assistant')
        && isClassAssistant(request.resource.data.classId)
        && !get(classPath(request.resource.data.classId)).data.get('archived', false)
        && validSessionCreate();
      allow update: if isClassAssistant(resource.data.classId)
        && validSessionUpdate();
      allow delete: if false;
    }

    match /sessionQr/{sessionId} {
      allow get: if hasRole('assistant')
        && (
          (resource == null
            && exists(sessionPath(sessionId))
            && isClassAssistant(get(sessionPath(sessionId)).data.classId))
          || (resource != null && isClassAssistant(resource.data.classId))
        );
      allow list: if hasRole('assistant')
        && isClassAssistant(resource.data.classId);
      allow create, update: if hasRole('assistant')
        && request.resource.data.keys().hasOnly([
          'sessionId', 'classId', 'token', 'expiresAt', 'createdBy', 'createdAt', 'expiresAtMs'
        ])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.createdBy == request.auth.uid
        && validText(request.resource.data.token, 12, 160)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && isClassAssistant(request.resource.data.classId)
        && exists(sessionPath(sessionId))
        && get(sessionPath(sessionId)).data.classId == request.resource.data.classId
        && get(sessionPath(sessionId)).data.status == 'open';
      allow delete: if hasRole('assistant') && isClassAssistant(resource.data.classId);
    }

    match /labs/{labId} {
      allow get, list: if signedIn();
      allow create, update: if hasRole('assistant')
        && request.resource.data.keys().hasAll([
          'id', 'name', 'building', 'latitude', 'longitude', 'radiusMeters', 'isActive'
        ])
        && request.resource.data.id == labId
        && validText(request.resource.data.name, 2, 120)
        && validText(request.resource.data.building, 2, 160)
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radiusMeters is number
        && request.resource.data.radiusMeters >= 10
        && request.resource.data.radiusMeters <= 500
        && request.resource.data.isActive is bool;
      allow delete: if hasRole('assistant');
    }

    match /attendance/{attendanceId} {
      allow get, list: if signedIn()
        && (request.auth.uid == resource.data.studentId
          || isClassAssistant(resource.data.classId));
      allow create: if hasRole('student') && validAttendanceCreate(attendanceId);
      allow create: if hasRole('assistant') && validAssistantAttendanceCreate(attendanceId);
      allow update, delete: if false;
    }

    match /leaveRequests/{leaveId} {
      allow get, list: if signedIn()
        && (request.auth.uid == resource.data.studentId
          || isClassAssistant(resource.data.classId));
      allow create: if hasRole('student') && validLeaveCreate(leaveId);
      allow update: if (
          isClassAssistant(resource.data.classId)
          && (
            validLeaveDecision()
            || validLeaveSentimentUpdate()
            || validLeaveClassificationFailure()
            || validLeaveClassificationSuccess()
          )
        )
        || (
          hasRole('student')
          && request.auth.uid == resource.data.studentId
          && (
            validLeaveClassificationFailure()
            || validLeaveClassificationSuccess()
          )
        );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn() && validNotificationCreate();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
